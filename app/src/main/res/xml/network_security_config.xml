<?xml version="1.0" encoding="utf-8"?>
<!-- Rede local sem TLS (troca entre aparelhos e servidores OPDS caseiros). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
